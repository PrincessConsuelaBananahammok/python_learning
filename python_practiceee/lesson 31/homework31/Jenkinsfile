pipeline {
    agent any

    stages {
        stage('Install venv') {
            steps {
                sh '''
                    apt-get update
                    apt-get install -y python3 python3-dev python3-pip python3.13-venv
                    python3 -m venv venv
                '''
            }
        }

        stage('Install requirements') {
            steps {
                sh '''
                    source venv/bin/activate
                    pip install -r requirements.txt
                    playwright install --with-deps
                '''
            }
        }

        stage('Run tests') {
            steps {
                sh '''
                    source venv/bin/activate
                    pytest python_practiceee/lesson28/homework28/tests/test_registration.py \
                        --alluredir=allure-results
                '''
            }
        }
    }

    post {
        always {
            allure commandline: 'Allure',
                   includeProperties: false,
                   jdk: '',
                   resultPolicy: 'LEAVE_AS_IS',
                   results: [[path: 'allure-results']]
        }
    }
}